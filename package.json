{
  "name": "accounting-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "npm run lint && npm run build",
    "deploy:tcb": "npm run build && npx -p @cloudbase/cli@latest tcb hosting deploy ./dist -e test-d3g2xaivpb160ef4f",
